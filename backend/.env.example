# 复制为 .env 后按需修改

# ============ 模型厂商：切换模型只改这两行 ============
# 可选值：anthropic / openai
LLM_VENDOR=anthropic
LLM_MODEL=claude-opus-5

# ---- anthropic ----
# 凭证留空时 SDK 会读取系统环境变量
ANTHROPIC_API_KEY=
# 使用第三方 Anthropic 兼容端点时填写，并把下面的 LLM_ENABLE_FALLBACKS 设为 false
# ANTHROPIC_BASE_URL=

# ---- openai ----
# LLM_VENDOR=openai 时必填
# OPENAI_API_KEY=sk-...
# 接第三方中转站时填写
# OPENAI_BASE_URL=https://api.example.com/v1
# 部分中转站只认已废弃的 max_tokens，官方端点保持 false
# OPENAI_LEGACY_MAX_TOKENS=false

# ============ 以下一般不用改 ============
LLM_MAX_TOKENS=16000
LLM_ENABLE_FALLBACKS=true
LLM_ENABLE_PROMPT_CACHE=true

# docker compose 里的 Postgres 映射在 55432 端口
DATABASE_URL=postgresql+asyncpg://offerpilot:offerpilot@localhost:55432/offerpilot

AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT_S=15

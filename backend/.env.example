# 复制为 .env 后按需修改
#
# 模型怎么配：只需要动第 1 节的 LLM_VENDOR 和 LLM_MODEL 两行。
# 用哪家、用哪个模型完全由你决定，代码里没有写死的模型清单，
# 中转站给的模型名直接填进去就行。

# ================= 1. 必改（就这两行） =================
# 厂商：anthropic 或 openai
LLM_VENDOR=anthropic
# 模型名，填你实际能调通的那个。官方写的是 claude-sonnet-5，
# 接第三方中转的话直接改成中转给你的模型名
LLM_MODEL=claude-sonnet-5

# ================= 2. 按需 =================
# 用 Claude 时：
#   留空则由 SDK 自己找凭证（环境变量、ant 登录的 profile 等），本地开发推荐这样
ANTHROPIC_API_KEY=
#   接第三方 Anthropic 兼容端点时填，并同时把 LLM_ENABLE_FALLBACKS 改成 false
# ANTHROPIC_BASE_URL=

# 用 OpenAI 时（LLM_VENDOR=openai）：
#   必填。LLM_VENDOR=openai 而这里为空，服务启动时会直接报错提示
# OPENAI_API_KEY=sk-...
#   接第三方中转站时填
# OPENAI_BASE_URL=https://example.com/v1
#   只有当中转站拒绝 max_completion_tokens 时才需要打开
# OPENAI_LEGACY_MAX_TOKENS=false

# ================= 3. 基本不用动 =================
# 单次调用允许的最大输出 token
LLM_MAX_TOKENS=16000
# Anthropic 服务端拒答回退。官方端点可用，接第三方端点时关掉
LLM_ENABLE_FALLBACKS=true
# 自动 prompt 缓存。长期复用的系统提示能显著降低成本
LLM_ENABLE_PROMPT_CACHE=true

# ================= 4. 其他 =================
# docker compose 里的 Postgres 映射在 55432 端口
DATABASE_URL=postgresql+asyncpg://offerpilot:offerpilot@localhost:55432/offerpilot

AGENT_MAX_STEPS=8
AGENT_TOOL_TIMEOUT_S=15

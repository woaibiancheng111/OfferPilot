# 生产环境变量模板
#
#   cp deploy/.env.production.example deploy/.env.production
#
# 这个文件已经在 .gitignore 里，填完真实的密钥后不要提交。
#
# 只有 LLM_VENDOR / LLM_MODEL 是必填的，模型名没有白名单，
# 填你实际能调通的那个就行。

# ============ 1. 必填 ============

# 数据库密码。postgres 容器和后端的 DATABASE_URL 都用它，
# 两处要填成同一个值
POSTGRES_PASSWORD=改成你自己的强密码

# 容器之间用服务名通信，不是 localhost
DATABASE_URL=postgresql+asyncpg://offerpilot:改成你自己的强密码@postgres:5432/offerpilot

# 厂商：anthropic 或 openai
LLM_VENDOR=anthropic
LLM_MODEL=claude-sonnet-5

# ============ 2. 按厂商 ============

# 用 Claude 时：
ANTHROPIC_API_KEY=

# 用 OpenAI 时（LLM_VENDOR=openai）：
# OPENAI_API_KEY=sk-...
# 接第三方中转站时再补 base_url，例如阿里云百炼：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_ENABLE_PROMPT_CACHE=false

# ============ 3. 基本不用动 ============

LLM_MAX_TOKENS=16000
# Claude 官方端点开这个；第三方兼容端点建议关掉，否则偶尔触发拒答回退
LLM_ENABLE_FALLBACKS=true
LLM_ENABLE_PROMPT_CACHE=true

# pydantic-settings 对 list 类型走 JSON 解析，所以要写成 JSON 数组
# 前端和后端同域走 nginx 转发，正常用不到 CORS；这里填上是为了直接打 API 时不报错
CORS_ORIGINS=["https://offerpilot.example.com"]

# trace 批量落库的节奏。轮询间隔 1s、攒够 50 条就写
TRACE_FLUSH_INTERVAL_S=1.0
TRACE_BATCH_SIZE=50
